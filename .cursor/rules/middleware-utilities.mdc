# 中间件和工具包指南

项目提供了丰富的中间件和工具包，用于处理横切关注点和通用功能。

## 中间件层

### 认证中间件

```go
// internal/middleware/auth.go
package middleware

import (
    "context"
    "kratos-kit/pkg/jwt"
    "strings"

    "github.com/go-kratos/kratos/v2/middleware"
    "github.com/go-kratos/kratos/v2/transport"
)

// AuthMiddleware 认证中间件
func AuthMiddleware(j jwt.JWT) middleware.Middleware {
    return func(handler middleware.Handler) middleware.Handler {
        return func(ctx context.Context, req interface{}) (interface{}, error) {
            // 从请求头获取 token
            if tr, ok := transport.FromServerContext(ctx); ok {
                if header, ok := tr.RequestHeader().Get("Authorization"); ok {
                    token := strings.TrimPrefix(header, "Bearer ")
                    if token != "" {
                        // 验证 token
                        claims, err := j.ValidateToken(token)
                        if err != nil {
                            return nil, errors.Unauthorized("INVALID_TOKEN", "无效的token")
                        }

                        // 将用户信息放入上下文
                        ctx = context.WithValue(ctx, "user_id", claims.UserID)
                        ctx = context.WithValue(ctx, "user_role", claims.Role)
                    }
                }
            }

            return handler(ctx, req)
        }
    }
}
```

### 限流中间件

```go
// internal/middleware/rate_limit.go
package middleware

import (
    "context"
    "kratos-kit/pkg/limit"

    "github.com/go-kratos/kratos/v2/middleware"
)

// RateLimit 限流中间件
func RateLimit(limiter *limit.Limiter) middleware.Middleware {
    return func(handler middleware.Handler) middleware.Handler {
        return func(ctx context.Context, req interface{}) (interface{}, error) {
            // 检查是否允许请求
            if !limiter.Allow() {
                return nil, errors.TooManyRequests("RATE_LIMIT_EXCEEDED", "请求过于频繁")
            }

            return handler(ctx, req)
        }
    }
}
```

### 日志中间件

```go
// internal/middleware/logging.go
package middleware

import (
    "context"
    "time"

    "github.com/go-kratos/kratos/v2/log"
    "github.com/go-kratos/kratos/v2/middleware"
)

// Logging 日志中间件
func Logging(logger log.Logger) middleware.Middleware {
    return func(handler middleware.Handler) middleware.Handler {
        return func(ctx context.Context, req interface{}) (interface{}, error) {
            start := time.Now()
            reply, err := handler(ctx, req)
            duration := time.Since(start)

            // 记录请求日志
            log.WithContext(ctx, logger).Infof(
                "[HTTP] %s %s %v %s",
                "GET", // 可通过上下文获取实际方法
                "/path", // 可通过上下文获取实际路径
                duration,
                err,
            )

            return reply, err
        }
    }
}
```

## 工具包使用指南

### JWT 工具包

```go
// pkg/jwt/jwt.go
package jwt

import (
    "time"
    "kratos-kit/pkg/util"
)

// JWT JWT 操作接口
type JWT interface {
    GenerateToken(userID int64, role string, expireTime time.Duration) (string, error)
    ValidateToken(token string) (*Claims, error)
    RefreshToken(token string) (string, error)
}

// 使用示例
jwt := jwt.NewJWT(&conf.JWT{
    Secret: "your-secret-key",
    Expire: 24 * time.Hour,
})

// 生成 token
token, err := jwt.GenerateToken(123, "admin", 24*time.Hour)

// 验证 token
claims, err := jwt.ValidateToken(token)
```

### 缓存工具包

```go
// pkg/cache/cache.go
package cache

import (
    "context"
    "time"
)

// Cache 缓存接口
type Cache interface {
    Get(ctx context.Context, key string) (string, error)
    Set(ctx context.Context, key string, value string, expiration time.Duration) error
    Delete(ctx context.Context, key string) error
    Exists(ctx context.Context, key string) bool
}

// 使用示例
cache := cache.NewRedisCache(redisClient)

// 设置缓存
err := cache.Set(ctx, "user:123", userJSON, time.Hour)

// 获取缓存
data, err := cache.Get(ctx, "user:123")
```

