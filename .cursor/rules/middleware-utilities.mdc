### 并发工具包

```go
// pkg/concurrent/future.go
package concurrent

import (
    "context"
    "time"
)

// Future 异步执行结果
func Future(ctx context.Context, fn func() (interface{}, error)) *FutureResult {
    result := &FutureResult{
        done: make(chan struct{}),
    }

    go func() {
        defer close(result.done)
        result.value, result.err = fn()
    }()

    return result
}

// 使用示例
future := concurrent.Future(ctx, func() (interface{}, error) {
    return expensiveOperation()
})

// 等待结果或超时
select {
case <-future.Done():
    value, err := future.Result()
    // 处理结果
case <-time.After(5 * time.Second):
    // 超时处理
}
```

### 锁工具包

```go
// pkg/lock/lock.go
package lock

import (
    "context"
    "time"
)

// DistributedLock 分布式锁接口
type DistributedLock interface {
    Lock(ctx context.Context, key string, ttl time.Duration) (bool, error)
    Unlock(ctx context.Context, key string) error
    Refresh(ctx context.Context, key string, ttl time.Duration) error
}

// 使用分布式锁
lock := lock.NewRedisLock(redisClient)

success, err := lock.Lock(ctx, "resource:123", 30*time.Second)
if !success {
    return errors.Conflict("RESOURCE_LOCKED", "资源已被锁定")
}
defer lock.Unlock(ctx, "resource:123")

// 执行临界区操作
```

### HTTP 客户端工具包

```go
// pkg/http/http.go
package http

import (
    "bytes"
    "context"
    "encoding/json"
    "io"
    "net/http"
    "time"
)

// HTTPClient 封装的 HTTP 客户端
type HTTPClient interface {
    Get(ctx context.Context, url string) ([]byte, error)
    Post(ctx context.Context, url string, data interface{}) ([]byte, error)
    Put(ctx context.Context, url string, data interface{}) ([]byte, error)
    Delete(ctx context.Context, url string) ([]byte, error)
}

// 使用示例
client := http.NewHTTPClient(&http.Config{
    Timeout: 30 * time.Second,
    RetryCount: 3,
})

// 发送 POST 请求
var result map[string]interface{}
err := client.Post(ctx, "https://api.example.com/users",
    map[string]string{"name": "John", "email": "john@example.com"},
    &result)
```

## 最佳实践

1. **中间件组合**: 合理组合中间件，避免过度包装
2. **错误处理**: 中间件应正确处理和传递错误
3. **上下文管理**: 通过上下文传递用户信息和请求元数据
4. **性能考虑**: 中间件应尽量减少延迟，避免阻塞操作
5. **可配置性**: 中间件行为应可通过配置调整
6. **可测试性**: 中间件应易于单元测试和集成测试
7. **安全性**: 敏感操作使用加密和安全的通信方式